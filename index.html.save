nano ~/Downloads/fi2233fi.github.io/index.html
nano ~/Downloads/fi2233fi.github.io/index.html<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fatima Iqbal | Data Analyst</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--ivory:#FAF7F2;--warm-white:#F5F1EA;--gold:#C4A55A;--gold-light:#E8D5A3;--gold-dark:#9A7A35;--crimson:#8B2635;--crimson-light:#C4525F;--crimson-pale:#F5E8EA;--sage:#5C7A65;--sage-light:#A8C4AE;--sage-pale:#EAF0EB;--dusty-rose:#C4788A;--dusty-rose-pale:#F7EEF0;--ink:#1C1812;--muted:#8A7E6A;--border:rgba(196,165,90,0.25);--border-soft:rgba(196,165,90,0.12)}
html,body{min-height:100vh;background:var(--ivory);font-family:'DM Sans',sans-serif;color:var(--ink);overflow-x:hidden}
nav{display:flex;justify-content:space-between;align-items:center;padding:1.75rem 5vw;border-bottom:0.5px solid var(--border-soft)}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:400;letter-spacing:0.15em;color:var(--ink);text-transform:uppercase;text-decoration:none}
.nav-links{display:flex;gap:2.5rem;list-style:none}
.nav-links a{font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color 0.2s}
.nav-links a:hover{color:var(--crimson)}
.hero{display:grid;grid-template-columns:1fr 360px;gap:5rem;align-items:center;padding:5rem 5vw 4rem;max-width:1200px;margin:0 auto}
.hero-eyebrow{font-size:0.68rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--crimson);margin-bottom:1.25rem;display:flex;align-items:center;gap:0.75rem}
.hero-eyebrow::before{content:'';display:block;width:28px;height:1px;background:var(--crimson)}
.hero-name{font-family:'Cormorant Garamond',serif;font-size:clamp(3rem,6vw,5rem);font-weight:300;line-height:1.05;color:var(--ink);margin-bottom:1.5rem}
.hero-name em{font-style:italic;color:var(--crimson)}
.hero-desc{font-size:0.95rem;line-height:1.85;color:var(--muted);max-width:460px;margin-bottom:1.75rem;font-weight:300}
.hero-skills{display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:2.5rem}
.skill-tag{font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.3rem 0.8rem;border:0.5px solid var(--border);color:var(--muted);background:var(--warm-white)}
.cta-row{display:flex;gap:1rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:0.6rem;padding:0.85rem 2rem;font-family:'DM Sans',sans-serif;font-size:0.72rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:all 0.3s ease}
.btn-primary{background:var(--crimson);color:#FAF7F2;border:1px solid var(--crimson)}
.btn-primary:hover{background:#6E1C28;border-color:#6E1C28}
.btn-outline{background:transparent;color:var(--ink);border:1px solid var(--border)}
.btn-outline:hover{border-color:var(--sage);color:var(--sage)}
.hero-image-wrap{position:relative}
.hero-image-frame{position:relative;width:100%;aspect-ratio:3/4;overflow:hidden}
.hero-image-frame::before{content:'';position:absolute;top:-10px;right:-10px;width:55%;height:55%;border-top:1px solid var(--crimson-light);border-right:1px solid var(--crimson-light);z-index:2;opacity:0.5}
.hero-image-frame::after{content:'';position:absolute;bottom:-10px;left:-10px;width:55%;height:55%;border-bottom:1px solid var(--sage);border-left:1px solid var(--sage);z-index:2;opacity:0.5}
.hero-image-frame img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}
.image-caption{margin-top:1rem;display:flex;justify-content:space-between;align-items:center}
.image-location{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:0.8rem;color:var(--muted)}
.color-dots{display:flex;gap:5px}
.color-dot{width:8px;height:8px;border-radius:50%}
.stats-band{background:var(--ink);padding:2.5rem 5vw;display:grid;grid-template-columns:repeat(5,1fr)}
.stat-item{text-align:center;border-right:0.5px solid rgba(255,255,255,0.08);padding:0 1rem}
.stat-item:last-child{border-right:none}
.stat-num{font-family:'Cormorant Garamond',serif;font-size:2.6rem;font-weight:300;color:var(--gold-light);display:block;line-height:1;margin-bottom:0.4rem}
.stat-label{font-size:0.6rem;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.4)}
.work-section{padding:5rem 5vw;max-width:1200px;margin:0 auto}
.section-header{display:flex;align-items:center;gap:1rem;margin-bottom:3rem}
.section-label{font-size:0.65rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold);white-space:nowrap}
.section-line{flex:1;height:0.5px;background:var(--border)}
.work-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem}
.work-card{cursor:pointer;transition:all 0.35s ease;position:relative;overflow:hidden;text-decoration:none;display:block}
.card-color-bar{height:4px;width:100%;transition:height 0.3s ease}
.work-card:hover .card-color-bar{height:6px}
.card-body{padding:2.5rem;border:0.5px solid var(--border);border-top:none;background:var(--warm-white);transition:background 0.3s}
.work-card:hover .card-body{background:#FFFDF8}
.card-number{font-family:'Cormorant Garamond',serif;font-size:3rem;font-weight:300;line-height:1;margin-bottom:1.25rem;opacity:0.25;transition:opacity 0.3s}
.work-card:hover .card-number{opacity:0.5}
.card-tag{display:inline-block;font-size:0.6rem;letter-spacing:0.18em;text-transform:uppercase;padding:0.3rem 0.75rem;margin-bottom:1rem}
.card-title{font-family:'Cormorant Garamond',serif;font-size:1.85rem;font-weight:400;color:var(--ink);line-height:1.2;margin-bottom:1rem}
.card-desc{font-size:0.83rem;line-height:1.8;color:var(--muted);font-weight:300;margin-bottom:2rem}
.card-pills{display:flex;flex-wrap:wrap;gap:0.5rem}
.pill{font-size:0.62rem;letter-spacing:0.08em;text-transform:uppercase;padding:0.3rem 0.7rem;border:0.5px solid var(--border);color:var(--muted)}
.card-arrow{position:absolute;bottom:2rem;right:2rem;font-size:1.1rem;transition:all 0.3s;color:var(--gold-light)}
.work-card:hover .card-arrow{transform:translate(3px,-3px);color:var(--gold)}
.domains-strip{display:flex;gap:1rem}
.domain-chip{flex:1;padding:1.5rem;text-align:center;border:0.5px solid var(--border-soft)}
.domain-icon{font-size:1.3rem;margin-bottom:0.5rem;display:block}
.domain-name{font-size:0.62rem;letter-spacing:0.15em;text-transform:uppercase;display:block}
.about-band{background:var(--warm-white);border-top:0.5px solid var(--border-soft);border-bottom:0.5px solid var(--border-soft);padding:4rem 5vw}
.about-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:280px 1fr;gap:4rem;align-items:start}
.about-heading{font-family:'Cormorant Garamond',serif;font-size:2.2rem;font-weight:300;line-height:1.2;color:var(--ink)}
.about-heading em{font-style:italic;color:var(--gold-dark)}
.about-text{font-size:0.9rem;line-height:1.9;color:var(--muted);font-weight:300;margin-bottom:2rem}
.edu-row{display:flex;gap:1.5rem}
.edu-item{flex:1;padding:1.25rem;border:0.5px solid var(--border);background:var(--ivory)}
.edu-degree{font-size:0.75rem;font-weight:500;color:var(--ink);margin-bottom:0.3rem}
.edu-school{font-size:0.72rem;color:var(--muted);line-height:1.5}
.edu-year{font-family:'Cormorant Garamond',serif;font-size:1.1rem;color:var(--gold);margin-top:0.5rem;display:block}
footer{border-top:0.5px solid var(--border-soft);padding:2.5rem 5vw;display:flex;justify-content:space-between;align-items:center}
.footer-name{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:0.9rem;color:var(--muted)}
.footer-links{display:flex;gap:2rem}
.footer-links a{font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color 0.2s}
.footer-links a:hover{color:var(--crimson)}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
.hero-text{animation:fadeUp 0.7s ease forwards}
.hero-image-wrap{animation:fadeUp 0.7s 0.15s ease both}
.stats-band{animation:fadeUp 0.6s 0.2s ease both}
.work-card:nth-child(1){animation:fadeUp 0.6s 0.3s ease both}
.work-card:nth-child(2){animation:fadeUp 0.6s 0.4s ease both}
</style>
</head>
<body>

<nav>
  <a class="nav-logo" href="#">Fatima Iqbal</a>
  <ul class="nav-links">
    <li><a href="#work">Work</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="https://linkedin.com/in/fatimaiqbal99" target="_blank">LinkedIn</a></li>
    <li><a href="https://github.com/fi2233fi" target="_blank">GitHub</a></li>
  </ul>
</nav>

<section class="hero">
  <div class="hero-text">
    <p class="hero-eyebrow">Data Analyst &amp; RCM Specialist · Dix Hills, NY</p>
    <h1 class="hero-name">Finding the<br>story in <em>the<br>numbers.</em></h1>
    <p class="hero-desc">M.S. Data Science with a background spanning healthcare revenue cycle, data operations, and digital marketing. Every role a different lens on the same question — what does the data actually say?</p>
    <div class="hero-skills">
      <span class="skill-tag">Python</span>
      <span class="skill-tag">SQL</span>
      <span class="skill-tag">Power BI</span>
      <span class="skill-tag">AWS</span>
      <span class="skill-tag">dbt</span>
      <span class="skill-tag">Healthcare RCM</span>
      <span class="skill-tag">ETL Pipelines</span>
    </div>
    <div class="cta-row">
      <a href="#work" class="btn btn-primary">View Work <span>→</span></a>
      <a href="mailto:fi.fatimaiqbal.fi@gmail.com" class="btn btn-outline">Get in Touch <span>→</span></a>
    </div>
  </div>
  <div class="hero-image-wrap">
    <div class="hero-image-frame">
      <img src="profile.jpg" alt="Fatima Iqbal">
    </div>
    <div class="image-caption">
      <span class="image-location">Dix Hills, New York</span>
      <div class="color-dots">
        <div class="color-dot" style="background:var(--crimson)"></div>
        <div class="color-dot" style="background:var(--gold)"></div>
        <div class="color-dot" style="background:var(--sage)"></div>
      </div>
    </div>
  </div>
</section>

<div class="stats-band">
  <div class="stat-item"><span class="stat-num">25%</span><span class="stat-label">Online Sales Growth</span></div>
  <div class="stat-item"><span class="stat-num">33%</span><span class="stat-label">YoY Revenue Growth</span></div>
  <div class="stat-item"><span class="stat-num">15%</span><span class="stat-label">Billing Accuracy Gain</span></div>
  <div class="stat-item"><span class="stat-num">35%</span><span class="stat-label">Organic Traffic Lift</span></div>
  <div class="stat-item"><span class="stat-num">20%</span><span class="stat-label">Provider Utilization Up</span></div>
</div>

<section class="work-section" id="work">
  <div class="section-header">
    <span class="section-label">Selected Work</span>
    <div class="section-line"></div>
  </div>
  <div class="work-grid">
    <a href="projects.html" class="work-card">
      <div class="card-color-bar" style="background:linear-gradient(90deg,var(--crimson),var(--dusty-rose))"></div>
      <div class="card-body">
        <div class="card-number" style="color:var(--crimson)">01</div>
        <span class="card-tag" style="background:var(--crimson-pale);color:var(--crimson)">Analytics Projects</span>
        <h2 class="card-title">Data &amp; Analytics Portfolio</h2>
        <p class="card-desc">Healthcare claims analysis, credit risk modeling, fraud detection, and marketing intelligence. End-to-end pipelines built with Python, Power BI, AWS, and dbt.</p>
        <div class="card-pills">
          <span class="pill">Python</span>
          <span class="pill">Power BI</span>
          <span class="pill">AWS</span>
          <span class="pill">dbt</span>
          <span class="pill">Healthcare</span>
        </div>
        <span class="card-arrow">↗</span>
      </div>
    </a>
    <a href="https://github.com/fi2233fi/sql-analytics-portfolio" target="_blank" class="work-card">
      <div class="card-color-bar" style="background:linear-gradient(90deg,var(--sage),var(--sage-light))"></div>
      <div class="card-body">
        <div class="card-number" style="color:var(--sage)">02</div>
        <span class="card-tag" style="background:var(--sage-pale);color:var(--sage)">SQL Portfolio</span>
        <h2 class="card-title">SQL Analytics Portfolio</h2>
        <p class="card-desc">12 queries across healthcare, retail, finance, and operations — each executed against a live MySQL database with documented real findings.</p>
        <div class="card-pills">
          <span class="pill">MySQL</span>
          <span class="pill">CTEs</span>
          <span class="pill">Window Fns</span>
          <span class="pill">RCM</span>
          <span class="pill">Aggregations</span>
        </div>
        <span class="card-arrow">↗</span>
      </div>
    </a>
  </div>
  <div class="domains-strip">
    <div class="domain-chip" style="border-color:rgba(139,38,53,0.2);background:var(--crimson-pale)">
      <span class="domain-icon">🏥</span>
      <span class="domain-name" style="color:var(--crimson)">Healthcare</span>
    </div>
    <div class="domain-chip" style="border-color:rgba(196,165,90,0.3);background:#FBF5E8">
      <span class="domain-icon">💳</span>
      <span class="domain-name" style="color:var(--gold-dark)">Finance</span>
    </div>
    <div class="domain-chip" style="border-color:rgba(92,122,101,0.2);background:var(--sage-pale)">
      <span class="domain-icon">🛒</span>
      <span class="domain-name" style="color:var(--sage)">Retail</span>
    </div>
    <div class="domain-chip" style="border-color:rgba(196,120,138,0.2);background:var(--dusty-rose-pale)">
      <span class="domain-icon">📊</span>
      <span class="domain-name" style="color:var(--dusty-rose)">Operations</span>
    </div>
  </div>
</section>

<div class="about-band" id="about">
  <div class="about-inner">
    <div>
      <h2 class="about-heading">A little more <em>about<br>the work.</em></h2>
    </div>
    <div>
      <p class="about-text">Started in digital marketing, moved into data operations managing 20+ concurrent client migrations at Housecall Pro, and now deep in healthcare revenue cycle at Masoom Rehab. Each role sharpened a different skill — storytelling, data integrity, and operational pattern recognition. The throughline has always been finding what the data is actually saying before anyone else does.</p>
      <div class="edu-row">
        <div class="edu-item">
          <p class="edu-degree">M.S. Data Science</p>
          <p class="edu-school">St. John's University<br>Concentration: Cybersecurity</p>
          <span class="edu-year">2025</span>
        </div>
        <div class="edu-item">
          <p class="edu-degree">B.B.A. Digital Marketing</p>
          <p class="edu-school">Baruch College, CUNY<br>Zicklin School of Business</p>
          <span class="edu-year">2022</span>
        </div>
      </div>
    </div>
  </div>
</div>

<footer>
  <span class="footer-name">Fatima Iqbal, 2026</span>
  <div class="footer-links">
    <a href="https://github.com/fi2233fi" target="_blank">GitHub</a>
    <a href="https://linkedin.com/in/fatimaiqbal99" target="_blank">LinkedIn</a>
    <a href="mailto:fi.fatimaiqbal.fi@gmail.com">Email</a>
  </div>
</footer>

</body>
</html>
